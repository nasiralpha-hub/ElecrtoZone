# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Frontend Origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Session & Authentication
SESSION_SECRET=your-super-secret-session-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Encryption
APP_ENCRYPTION_KEY=your-32-char-encryption-key-here

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
META_APP_SECRET=

# Meta Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v19.0

# AI Agent (Windows Ollama)
AI_AGENT_KEY=
AI_JOB_BATCH_SIZE=2
AI_JOB_LEASE_SECONDS=300
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Image Storage
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_REGION=
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=
IMAGE_STORAGE_PUBLIC_URL=
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif

# Payment Provider
PAYMENT_PROVIDER=none
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_WHATSAPP=true
ENABLE_META_MARKETING=true
ENABLE_IMAGE_DISCOVERY=true